{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treeline",
  "version": "0.3.6",
  "identifier": "com.treeline.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Treeline",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Treeline",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "shortDescription": "A fast, provider-independent Git client",
    "longDescription": "Treeline is a fast desktop Git client with tabs, bookmarks, submodules, history graph, staging by hunk or line, merge and rebase tools. It works with any Git remote.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzN0QyRDBENzE3MzVBQjYKUldTMlduTnhEUzE5ZzhGbkNkNEhISEVMbDlKZFY4bStOZjlUaDkvSzFodGgvYmpsRzFyR1VaeFgK",
      "endpoints": [
        "https://github.com/suhailaleryani/treeline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
